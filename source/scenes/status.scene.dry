title: Status
new-page: true
is-special: true
on-arrival: {!
if (Q.unemployed) {
    Q.unemployed_2 = Q.unemployed.toFixed(1);
}
if (Q.inflation) {
    Q.inflation_2 = Q.inflation.toFixed(1);
}
Q.economic_growth_2 = '0';
if (Q.economic_growth) {
    Q.economic_growth_2 = Q.economic_growth.toFixed(1);
}
!}

= Status

[+ month : month +] [+ year +]

Resources available: [+ resources +]

KPD position: [? if kpd_toleration : toleration ?][? if kpd_in_government : in government - ?][? if kpd_toleration == 0 and kpd_in_government == 0 and kpd_caretaker == 0 : opposition ?][? if kpd_caretaker : caretaker government ?]
[? if in_weimar_coalition and kpd_in_government: Weimar Coalition ?][? if in_grand_coalition and kpd_in_government: Grand Coalition ?][? if in_popular_front and kpd_in_government: Popular Front ?][? if in_united_front and kpd_in_government: Left Front ?][? if in_spd_majority and spd_in_government: SPD majority ?][? if in_minority_government and spd_in_government: minority government ?][? if in_emergency_government and spd_in_government: emergency government ?]

[? if kpd_in_government and not in_kpd_majority and not in_united_front : Coalition dissent: [+ coalition_dissent : coalition_dissent +] ?]

[? if kpd_in_government and (in_united_front or in_popular_front): SPD coalition dissent: [+ spd_coalition_dissent : coalition_dissent +] ?]

Internal dissent: [+ dissent_percent : dissent +]

