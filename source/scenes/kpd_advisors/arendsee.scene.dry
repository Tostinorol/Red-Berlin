@arbeiterhilfe
title: Arbeierhilfe
subtitle: Utilize our mutual aid organization to increase our standing among the working class.
choose-if: advisor_action_timer <= 0
unavailable-subtitle: [? if advisor_action_timer > 0 : [+ advisor_action_timer +] months before next advisor action. ?] 
on-arrival: advisor_action_timer = 6; worker_kpd += 3*(1-dissent); unemployed_kpd += 3*(1-dissent)

